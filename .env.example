# Judge credentials, read by utils/llm_invoke.py. Copy to .env; never commit .env.
# EVAL_JUDGE_PROVIDER = openai (default; gpt-6-astra, the v1 paper judge) | azure | anthropic
EVAL_JUDGE_PROVIDER=openai
# EVAL_JUDGE_MODEL=gpt-6-astra

# openai
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
# OPENAI_BASE_URL=https://api.openai.com/v1

# azure (same model; deployment named gpt-6-astra)
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_KEY=YOUR_AZURE_KEY_HERE
# AZURE_OPENAI_DEPLOYMENT=gpt-6-astra
# AZURE_OPENAI_API_VERSION=2024-10-21

# anthropic (judge-sensitivity runs only; scores are not comparable with results/)
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
